# YouTube Data API credentials for yt-data-api-mcp.
#
# Copy this file to `.env` (or wherever you run the server) and fill in values.
# The server reads these from the process environment.
#
# For a public (read-only) API key: https://developers.google.com/youtube/v3/getting-started

# --- Option A: API key (public reads only: playlists_list / playlistItems_list by id/channelId) ---
YOUTUBE_API_KEY=YOUR_GOOGLE_API_KEY

# --- Option B: OAuth2 access token (enables write tools and mine=true) ---
YOUTUBE_ACCESS_TOKEN=